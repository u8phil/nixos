{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@3.0.4/oh-my-opencode-slim.schema.json",
  "autoUpdate": false,
  "disabled_agents": [
    "librarian",
    "observer",
    "council"
  ],
  "disabled_mcps": [
    "context7",
    "gh_grep"
  ],
  "disabled_tools": [
    "ast_grep_search",
    "ast_grep_replace",
    "task_reply",
    "marketplace_manage",
    "marketplace_inspect",
    "acp_run",
    "interview_submit_state"
  ],
  "disabled_commands": [
    "interview"
  ],
  "webfetch": {
    "enabled": false
  },
  "companion": {
    "enabled": false
  },
  "multiplexer": {
    "type": "none"
  },
  "backgroundJobs": {
    "concurrency": {
      "defaultConcurrency": 2
    },
    "wallClockTimeoutMs": 1800000
  },
  "fallback": {
    "enabled": false
  },
  "agents": {
    "orchestrator": {
      "model": "anthropic/claude-opus-5-5",
      "variant": "medium",
      "skills": [
        "debugging",
        "typesafe-ai"
      ],
      "mcps": [
        "github",
        "nixos",
        "websearch"
      ]
    },
    "explorer": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high",
      "skills": [
        "debugging",
        "typesafe-ai"
      ],
      "mcps": [
        "github",
        "nixos",
        "websearch"
      ]
    },
    "fixer": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "max",
      "skills": [
        "debugging",
        "typesafe-ai"
      ],
      "mcps": [
        "github",
        "nixos",
        "websearch"
      ],
      "permission": {
        "task": {
          "*": "deny",
          "explorer": "allow"
        }
      }
    },
    "designer": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "max",
      "skills": [
        "debugging",
        "typesafe-ai"
      ],
      "mcps": [
        "github",
        "nixos",
        "websearch"
      ],
      "permission": {
        "task": {
          "*": "deny",
          "explorer": "allow"
        }
      }
    },
    "oracle": {
      "model": "opencode-go/kimi-k3.1-pro",
      "variant": "max",
      "skills": [
        "debugging",
        "typesafe-ai"
      ],
      "mcps": [
        "github",
        "nixos",
        "websearch"
      ]
    }
  }
}
